# Copy to .env (gitignored) to preset personal defaults for a dev checkout.
# Anything you change in the Settings window overrides these.
# Every value is optional; the environment overrides the file.

# Remote Qwen3-ASR server. Empty = transcribe on this Mac.
VVRITE_STT_ENDPOINT=

# OpenAI-compatible chat endpoint for post-ASR correction.
# Works with on-device ASR too — a remote ASR server is not required.
VVRITE_LLM_ENDPOINT=http://your-server:8000/v1/chat/completions
VVRITE_LLM_MODEL=your-model-name

# One line about who is speaking. Without it the corrector has no domain to
# anchor on and leaves jargon mangled.
VVRITE_LLM_CONTEXT=

# Comma-separated spellings the recognizer and corrector must not change.
VVRITE_CUSTOM_WORDS=
