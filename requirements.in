# Recompile requirements.txt for the supported Python/macOS target with:
#
#   uv pip compile requirements.in \
#     --python-version 3.11 \
#     --output-file requirements.txt
#
# Keep the inference stack pinned together. mlx-audio has a broad dependency
# surface, and unconstrained upgrades have previously changed both the frozen
# app contents and runtime behavior between builds.
